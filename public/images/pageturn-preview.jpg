<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#161616"/>
        <stop offset="100%" stop-color="#0d0d0d"/>
      </linearGradient>
      <linearGradient id="curl" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#009dff"/>
        <stop offset="100%" stop-color="#0055ff"/>
      </linearGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    <rect width="800" height="500" fill="url(#bg)"/>
    <!-- Page Curl graphic -->
    <path d="M 200 120 L 520 120 C 580 120 620 180 620 380 L 200 380 Z" fill="#202020" stroke="#333" stroke-width="2"/>
    <path d="M 520 120 C 580 120 620 180 620 380 L 560 380 C 520 280 480 200 440 180 Z" fill="url(#curl)" opacity="0.6" filter="url(#glow)"/>
    <text x="400" y="240" font-family="system-ui, sans-serif" font-size="44" font-weight="900" fill="#e3e3e3" text-anchor="middle" letter-spacing="4">AH_PAGETURN</text>
    <text x="400" y="290" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="#009dff" text-anchor="middle" filter="url(#glow)">3D REALISTIC BOOK &amp; PAPER SIMULATION</text>
  </svg>